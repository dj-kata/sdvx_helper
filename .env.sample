# Windows版uvのパス
# WSLから実行できる Windows 側の uv.exe を指定してください。
# Path to the Windows version of uv.
# Specify the Windows-side uv.exe that can be run from WSL.
WUV=/mnt/c/Users/<user>/.local/bin/uv.exe

# 未登録ジャケット情報の開発用Discord Webhook URL
# 必要な行だけ .env にコピーして URL を設定してください。
# 未設定または空欄の場合、その経路の送信は静かにスキップされます。
# Discord Webhook URL for development reports of unregistered jacket information.
# Copy only the lines you need into .env and set their URLs.
# If unset or left blank, sending through that route is silently skipped.

# リザルト画面で認識できなかったNOV譜面
# NOV chart that could not be recognized on the result screen.
SDVX_HELPER_UNKNOWN_JACKET_RESULT_NOV_WEBHOOK_URL=

# リザルト画面で認識できなかったADV譜面
# ADV chart that could not be recognized on the result screen.
SDVX_HELPER_UNKNOWN_JACKET_RESULT_ADV_WEBHOOK_URL=

# リザルト画面で認識できなかったEXH譜面
# EXH chart that could not be recognized on the result screen.
SDVX_HELPER_UNKNOWN_JACKET_RESULT_EXH_WEBHOOK_URL=

# リザルト画面で認識できなかった最上位譜面(MXM/INF/GRV/HVN/VVD/XCD)
# Highest-difficulty chart (MXM/INF/GRV/HVN/VVD/XCD) that could not be recognized on the result screen.
SDVX_HELPER_UNKNOWN_JACKET_RESULT_APPEND_WEBHOOK_URL=

# スコアビューワ編集モードで追加され、認識DBにジャケットhashが無い譜面
# Chart added in score viewer edit mode that has no jacket hash in the recognition DB.
SDVX_HELPER_MISSING_JACKET_HASH_EDIT_WEBHOOK_URL=
